# Copy to .env and fill in. Never commit .env.

# Bearer key required by the inference server; the UI sends it automatically.
# Generate: openssl rand -hex 32
MUSIC_API_KEY=

# Hugging Face token — only needed if the repo ever requires auth (currently public).
HF_TOKEN=

# vast.ai template env (not used by docker-compose):
# DEPLOY_REPO   — git URL of this repo, reachable from the instance
# DEPLOY_REF    — branch/tag/commit (default: main)
# OFFLOAD=1     — CPU-offload mode, ~22GB VRAM, slower
# PORTAL_CONFIG — localhost:1111:11111:/:Instance Portal|localhost:8787:18787:/:Music UI
#                 (external 8787 → Caddy TLS+auth → UI on internal 18787)
